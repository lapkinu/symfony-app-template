{% extends 'base.html.twig' %}

{% block title %}tarp.lt — Dev{% endblock %}

{% block body %}
    <main class="page">
        <section class="hero">
            <p class="eyebrow">tarp.lt</p>
            <h1>Home page</h1>
            <p class="description">
                Private development environment for tarp.lt.
                The application is up and running.
            </p>
            <div class="status-card">
                <div class="status-card__header">
                    <span>Application</span>
                    <span class="status">
                        Online
                    </span>
                </div>
                <dl class="status-card__details">
                    <div>
                        <dd>Framework</dd>
                        <span class="status">Symfony</span>
                    </div>
                    <div>
                        <dd>Environment</dd>
                        <span class="status">Production</span>
                    </div>
                    <div>
                        <dd>Status</dd>
                        <span class="status">Healthy</span>
                    </div>
                    <div>
                        <span>Status</span>
                        <span class="status">
                            <i class="status__dot" aria-hidden="true"></i>
                            Healthy
                        </span>
                    </div>
                </dl>
            </div>
        </section>
    </main>
{% endblock %}